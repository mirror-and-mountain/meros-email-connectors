{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "mirror-and-mountain/meros-email-connectors",
    "description": "A collection of email connectors for Meros powered WordPress themes.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "tmw-mm",
            "email": "toby@mirrorandmountain.com"
        }
    ],
    "require": {
        "mailchimp/marketing": "^3.0",
        "mailchimp/transactional": "^1.4"
    },
    "require-dev": {
        "illuminate/testing": "^13.0",
        "mirror-and-mountain/meros-framework": "^1.0",
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "autoload-dev": {
        "psr-4": {
            "MM\\Meros\\EmailConnectors\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:integration": "phpunit -c phpunit.integration.xml"
    },
    "autoload": {
        "psr-4": {
            "MM\\Meros\\EmailConnectors\\": "src/",
            "MM\\Meros\\EmailConnectors\\App\\": "src/app/"
        }
    },
    "extra": {
        "meros": {
            "provider": "MM\\Meros\\EmailConnectors\\ServiceProvider"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
